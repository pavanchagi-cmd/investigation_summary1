# Names only – set real values in Vercel (Settings → Environment Variables) or .env.local.
# Never commit real values.

# Added automatically when you connect Neon Postgres in the Vercel Storage tab.
# Leave unset locally to use the embedded PGlite database in .data/.
DATABASE_URL=

# Added automatically when you connect a Blob store in the Vercel Storage tab.
# Leave unset locally to store uploads in .data/uploads.
BLOB_READ_WRITE_TOKEN=

# Auth.js session secret (any long random string).
AUTH_SECRET=

# Gemini. The key is server-only and never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional override for the narrative call only.
GEMINI_NARRATIVE_MODEL=
# developer (Gemini Developer API) | agent_platform (Agent Platform / Vertex, fixed region)
GEMINI_BACKEND=developer
# Only for GEMINI_BACKEND=agent_platform
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Password for the seeded demo users (analyst@demo.local, analyst2@demo.local, qa@demo.local, admin@demo.local).
SEED_USER_PASSWORD=

# Local/test only: 1 = use recorded LLM fixtures instead of calling Gemini.
GEMINI_MOCK=
# Local only: 1 = run the live Gemini smoke test.
RUN_LIVE_LLM=
